# Sao chép file này thành .env rồi điền giá trị thật
# Tạo key ngẫu nhiên:  python -c "import secrets; print(secrets.token_urlsafe(32))"

# Khóa client gửi trong header X-API-Key khi gọi /jobs trên gateway.
VISION_API_KEY=
# Khóa quản trị: /admin/* trên gateway và mọi /jobs trên cổng worker.
VISION_ADMIN_KEY=

# Kết nối SQL Server (ghi đè section database trong config.yaml).
# VISION_DB_SERVER=172.16.34.250,1434
# VISION_DB_NAME=LabelSoftware
# VISION_DB_USER=vision_queue
VISION_DB_PASSWORD=

